<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hexaglue</groupId>
        <artifactId>hexaglue-parent</artifactId>
        <version>7.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>hexaglue-frontend</artifactId>
    <packaging>jar</packaging>

    <name>HexaGlue Frontend</name>
    <description>Reads Java sources and their classpath into the code model: type nodes, external stubs, typed edges with provenance, typed annotation values and the supertype closure. The only module that sees Spoon.</description>

    <properties>
        <hexaglue.root>${project.basedir}/..</hexaglue.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.hexaglue</groupId>
            <artifactId>hexaglue-model</artifactId>
        </dependency>
        <!-- The parser. Confined to this module by the enforcer and by ArchUnit:
             the boundary offered to the rest of the reactor is the code model. -->
        <dependency>
            <groupId>fr.inria.gforge.spoon</groupId>
            <artifactId>spoon-core</artifactId>
            <exclusions>
                <!-- Spoon needs these only for its MavenLauncher, which resolves a
                     POM to find source roots and a classpath. The frontend is given
                     both explicitly by its host, so the Maven APIs stay out of the
                     reactor entirely and the module boundary keeps its meaning. -->
                <exclusion>
                    <groupId>org.apache.maven</groupId>
                    <artifactId>maven-model</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.maven.shared</groupId>
                    <artifactId>maven-invoker</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Reads the supertype hierarchy of classpath types from their bytecode, which the
             parser cannot see without their sources. -->
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.hexaglue</groupId>
            <artifactId>hexaglue-testkit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- Overrides the reactor-wide ban: Spoon is allowed here, and
                         only here. Maven APIs and Lombok stay banned. -->
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.maven:*</exclude>
                                        <exclude>org.projectlombok:lombok</exclude>
                                    </excludes>
                                    <message>Module boundary violation: Maven APIs are allowed only in hexaglue-maven-plugin, Lombok nowhere.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
